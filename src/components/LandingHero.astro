---
import type { Locale, LocalizedPortfolio } from '../lib/content/types';

interface Props { locale: Locale; portfolio: LocalizedPortfolio }
const { locale, portfolio } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const route = (path: string) => `${base}/${locale}/${path}`;
const isZh = locale === 'zh';
const credentials = isZh
  ? '计算机科学硕士 · 游戏项目 / XR / 图形开发'
  : 'M.S. Computer Science · Game Projects / XR / Graphics';
---

<section class="landing-hero" aria-labelledby="landing-title">
  <div class="landing-frame">
    <p class="landing-label">{isZh ? '个人作品集 · 2026' : 'PORTFOLIO · 2026'}</p>
    <div class="landing-copy">
      <h1 id="landing-title" class="display-title">{portfolio.profile.name}</h1>
      <p class="landing-credentials">{credentials}</p>
    </div>
    <div class="landing-actions">
      <a class="button" href={route('journey/')}>{isZh ? '浏览项目' : 'Projects'}<span aria-hidden="true"> →</span></a>
      <a class="button secondary" href={route('about/')}>{isZh ? '个人信息' : 'About'}</a>
    </div>
    <p class="landing-contact"><a href={`mailto:${portfolio.profile.email}`}>{portfolio.profile.email}</a></p>
  </div>
</section>
