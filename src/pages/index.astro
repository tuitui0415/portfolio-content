---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Yunhan Wei — game designer and developer portfolio" />
    <title>Yunhan Wei · Portfolio</title>
    <script is:inline define:vars={{ base }}>
      (() => {
        const saved = localStorage.getItem('yunhan-portfolio-locale');
        const locale = saved === 'zh' || saved === 'en'
          ? saved
          : /^zh(?:-|$)/i.test(navigator.language)
            ? 'zh'
            : 'en';
        location.replace(`${base}/${locale}/`);
      })();
    </script>
  </head>
  <body>
    <main>
      <h1>魏允瀚 · Yunhan Wei</h1>
      <p>请选择语言 / Choose your language</p>
      <nav aria-label="Language selection">
        <a href={`${base}/zh/`}>中文</a>
        <a href={`${base}/en/`}>English</a>
      </nav>
    </main>
  </body>
</html>
