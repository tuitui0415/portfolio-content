---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JourneyShell from '../../components/JourneyShell.astro';
import { loadPortfolio, localizePortfolio } from '../../lib/content/load';
import type { Locale } from '../../lib/content/types';
import '../../styles/journey.css';

export function getStaticPaths() {
  return (['zh', 'en'] as Locale[]).map((lang) => ({ params: { lang } }));
}
const locale = Astro.params.lang as Locale;
const portfolio = localizePortfolio(loadPortfolio(), locale);
---

<BaseLayout locale={locale} title={`${locale === 'zh' ? '项目旅程' : 'Project Journey'} · Yunhan Wei`} description={locale === 'zh' ? '按时间探索魏允瀚的 15 个项目。' : 'Explore Yunhan Wei’s 15 projects across a playable timeline.'} bodyClass="journey-page">
  <JourneyShell locale={locale} portfolio={portfolio} />
</BaseLayout>
